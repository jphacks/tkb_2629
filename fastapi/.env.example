# PostgreSQLの接続URL。Docker Composeではホスト名をpostgresにする。
# 例: postgresql+psycopg://postgres:postgres@postgres:5432/fastapi
DATABASE_URL=
# Google Books APIキー。未設定の場合はAPIキーなしで書籍検索を行う。
BOOKS_API=
# Jev分析用のAPIキー。未設定の場合は実AIの代わりにモック分析を使用する。
TYPESAFE_API_KEY=
# 書誌情報のキャッシュに使用するRedisの接続先。
# Docker Composeではapiサービスの環境変数でredis://redis:6379/0に上書きされる。
REDIS_URL=redis://localhost:6379/0
# Web版フロントエンドの接続を許可するOrigin。複数指定はカンマ区切り。
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# 認証設定
# 開発中はdevelopment、本番はproduction。開発時のみHTTP用Cookieと平文SMTPを許可する。
APP_ENV=development
# JWTの署名・検証に使う秘密鍵。openssl rand -hex 32の出力値を貼り付ける。
# 再起動時も同じ値を使い、Gitやフロントエンドには公開しない。
AUTH_JWT_SECRET=
# JWTの発行元の識別名。トークンの発行時・検証時に同じ値を使用する。
AUTH_JWT_ISSUER=re-read-api

# メール確認・パスワード再設定に必要なSMTP設定
# 開発用ユーザー作成CLIでDBへ直接登録する場合は不要。手順はdocs/authentication.mdを参照。
# 利用するメール送信サービスのホスト名。例: smtp.example.com
SMTP_HOST=
# 送信ポート。通常はSTARTTLSで587、SSL/TLSで465。サービスの指定に合わせる。
# 未設定・空欄の場合は587を使用する。
SMTP_PORT=587
# 暗号化方式はstarttlsまたはssl。ローカル開発用SMTPではplainも使用できる。
# plainを使用する場合はAPP_ENV=developmentが必要。
SMTP_SECURITY=starttls
# 確認メールなどの送信元アドレス。メール送信サービスで使用を許可された値を指定する。
SMTP_FROM=
# SMTPへのログイン名。アプリ利用者のログイン情報とは別。
# 認証不要のローカル開発用SMTPでは空欄にする。
SMTP_USERNAME=
# メール送信サービスが指定するSMTP認証情報。Gitやフロントエンドには公開しない。
# 認証不要のローカル開発用SMTPでは空欄にする。
SMTP_PASSWORD=
